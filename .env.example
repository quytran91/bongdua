# ============================================================================
#  BÔNG DUA FLEUR — Bảng thông tin cần điền
# ============================================================================
#  Copy file này thành  .env  rồi điền. Sau đó chạy:
#
#      python tools/apply-env.py
#
#  Lệnh trên ghi các giá trị vào assets/js/config.js.
#  (Bạn cũng có thể mở thẳng assets/js/config.js sửa tay — kết quả như nhau.)
#
#  KHÔNG commit file .env thật lên git.
#  File này KHÔNG chứa và KHÔNG được chứa secret thật.
#
#  Ghi chú: đây là trang tĩnh nên trình duyệt không đọc .env lúc chạy.
#  Toàn bộ thông tin dưới đây là thông tin CÔNG KHAI (giờ, địa chỉ, số tài
#  khoản nhận tiền). Quyền ghi Google Sheets nằm ở Apps Script, không ở đây.
# ============================================================================


# ---------------------------------------------------------------- SỰ KIỆN --
# Đã xác nhận trong brief — chỉ sửa nếu chủ dự án đổi ý.
EVENT_DATE_ISO=2026-09-20
EVENT_PRICE_VND=488000

# Đọc từ poster, CẦN XÁC NHẬN LẠI.
EVENT_DATE_LABEL=Chủ nhật, 20.09.2026
WORKSHOP_TIME=8:30 – 11:30
CAFE_NAME=Lối Nhỏ Kafe
CAFE_ADDRESS=46 Ngõ 2 Hoàng Quốc Việt, Nghĩa Đô, Hà Nội
CAFE_NOTE=Không gian biệt thự vintage ấm cúng, yên tĩnh giữa lòng Hà Nội.
DRESSCODE=Trắng, Hồng, Hồng nude, Be

# Chưa có — để trống thì trang tự ẩn phần liên quan, không bịa nội dung.
CAFE_MAP_URL=
FOUNDER_NAME=
SEATS_TOTAL=


# ------------------------------------------------------------- THANH TOÁN --
# Để trống toàn bộ -> trang KHÔNG tạo QR giả, chỉ hiện mã đăng ký và báo
# "Bông Dua sẽ gửi thông tin chuyển khoản".
# Điền đủ BANK_BIN + BANK_ACCOUNT_NUMBER -> QR VietQR động, đúng số tiền
# 488.000đ và đúng nội dung "BONGDUA <mã đăng ký>".
#
# BANK_BIN là mã 6 số của ngân hàng theo chuẩn VietQR. Vài mã hay dùng:
#   Vietcombank 970436 · Techcombank 970407 · MB Bank 970422
#   BIDV 970418 · VietinBank 970415 · ACB 970416 · TPBank 970423
#   Sacombank 970403 · VPBank 970432 · Agribank 970405
# Danh sách đầy đủ: https://api.vietqr.io/v2/banks
BANK_NAME=VPBank
BANK_BIN=
BANK_ACCOUNT_NUMBER=0356622262
BANK_ACCOUNT_NAME=PHAM THI THANH THU

# Nếu muốn dùng ảnh QR tĩnh in sẵn thay vì VietQR động, đặt ảnh vào
# assets/qr/ rồi ghi đường dẫn ở đây. Lưu ý: QR tĩnh KHÔNG mang được số tiền
# và nội dung chuyển khoản theo từng người.
PAYMENT_QR_PATH=assets/img/payment-qr-760.jpg


# ---------------------------------------------------------------- LIÊN HỆ --
HOTLINE=0356622262
ZALO=0356622262
CONTACT_EMAIL=
SOCIAL_URL_FACEBOOK=https://www.facebook.com/BongDuaFleur
SOCIAL_URL_INSTAGRAM=
PRIVACY_URL=


# -------------------------------------------------------------- CHÍNH SÁCH --
# Để trống -> FAQ hiện "vui lòng liên hệ Bông Dua". Không tự bịa chính sách.
POLICY_REFUND=
POLICY_TRANSFER=
POLICY_PHOTO_DELIVERY=


# ------------------------------------------------------------------ BACKEND --
# URL Web App của Google Apps Script (kết thúc bằng /exec).
# Để trống -> form chạy CHẾ ĐỘ THỬ: validate đủ, hiện mã + modal thanh toán,
# nhưng không ghi vào Google Sheets (có cảnh báo rõ trên giao diện).
GOOGLE_APPS_SCRIPT_URL=

# Nếu muốn gửi thẳng vào Google Form đã có sẵn thay vì Apps Script, KHÔNG điền
# ở đây mà chạy:  python tools/google-form-ids.py "<link form>"
# rồi dán khối kết quả vào assets/js/config.js -> api.googleForm.
# Lưu ý: đường này không xác nhận được đã ghi thành công (xem README mục 5b).


# ---------------------------------------------------------------------- SEO --
SITE_CANONICAL=https://quytran91.github.io/bongdua/


# ============================================================================
#  KHÔNG ĐỂ Ở ĐÂY (và không để ở bất kỳ file nào của trang web):
#    GOOGLE_SERVICE_ACCOUNT_EMAIL
#    GOOGLE_PRIVATE_KEY
#    GOOGLE_SHEET_ID
#  Giải pháp Apps Script không cần service account: script chạy bằng chính
#  tài khoản Google sở hữu Sheet. Xem README mục "Kết nối Google Sheets".
#  Nếu sau này chuyển sang backend Node/Next.js dùng service account thì các
#  biến đó nằm ở biến môi trường của server, tuyệt đối không nằm trong repo.
# ============================================================================
